# Adapted from DuckDB benchmark/micro/index/range/wide_range_query_with_art.benchmark.
# Scale is reduced from 100M to 100K rows while preserving the range-count shape.
name Range Query (Index)
group art
subgroup range

load
CREATE TABLE integers (i INT, j INT);

generate
integers 100000 row row+2

postload
CREATE INDEX integers (i);

run
SELECT COUNT(*) FROM integers WHERE i < 15020;

result I
15020
