# Adapted from DuckDB benchmark/micro/aggregate/simple_group.benchmark.
# CTAS/range(10M) is replaced by a generated 100K-row CSV.
name Integer Sum (Grouped)
group aggregate

load
CREATE TABLE integers (i INT, j INT);

generate
integers 100000 row%5 row%100

run
SELECT i, SUM(j) FROM integers GROUP BY i ORDER BY i;

result II
0	950000
1	970000
2	990000
3	1010000
4	1030000
