# Adapted from DuckDB benchmark/micro/join/hashjoin_highcardinality.benchmark.
# INNER JOIN syntax is mapped to RMDB's equivalent comma-join predicate.
name High Cardinality Join (No Index, Count Only)
group join

load
CREATE TABLE t1 (v1 INT, v2 INT);
CREATE TABLE t2 (v1 INT, v2 INT);

generate
t1 1000 row row
t2 10000 row row

run
SELECT t1.v2 AS c0, t2.v2 AS c1, COUNT(*) AS c2
FROM t1, t2
WHERE t1.v1 = t2.v1
GROUP BY t1.v2, t2.v2
ORDER BY t1.v2
LIMIT 5;

result III
0	0	1
1	1	1
2	2	1
3	3	1
4	4	1
