# TPC-C profiling configuration (copy to config.env and customize)
# cp tests/prof/config.env.example tests/prof/config.env

# Benchmark parameters for profiling runs (shorter than full OJ test)
WARMUP_SEC=5
MEASURE_SEC=60
THREADS=16
SCALE=full          # mini | full
BENCH_SCRIPT=bench_tpcc.py

# perf record frequency (Hz)
PERF_FREQ=997

# Output directory (relative to build/)
PROF_OUT=prof_out
